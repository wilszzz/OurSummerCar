<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OSC.Core</AssemblyName>
    <RootNamespace>OSC.Core</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <Target Name="DeployOscCore" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(OscAssetRoot)\Core" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OscAssetRoot)\Core" SkipUnchangedFiles="true" />
  </Target>
</Project>
