<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OSC.Module.Vehicles.Boat</AssemblyName>
    <RootNamespace>OSC.Module.Vehicles.Boat</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OSC.Core\OSC.Core.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployVehiclesBoat" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(OscAssetRoot)\Modules" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OscAssetRoot)\Modules" SkipUnchangedFiles="true" />
  </Target>
</Project>
