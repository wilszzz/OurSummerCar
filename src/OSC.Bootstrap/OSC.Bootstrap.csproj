<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OurSummerCar</AssemblyName>
    <RootNamespace>OurSummerCar.Bootstrap</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OSC.Core\OSC.Core.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployBootstrap" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OscDeployRoot)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OscAssetRoot)\Modules" />
    <Copy SourceFiles="..\..\Assets\clothes.unity3d" DestinationFolder="$(OscAssetRoot)" SkipUnchangedFiles="true" Condition="Exists('..\..\Assets\clothes.unity3d')" />
    <Copy SourceFiles="..\..\Assets\wreckmp.unity3d" DestinationFolder="$(OscAssetRoot)" SkipUnchangedFiles="true" Condition="Exists('..\..\Assets\wreckmp.unity3d')" />
  </Target>
</Project>
